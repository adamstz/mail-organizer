# Copy this file to .env and fill in the values below, then run:
#   docker compose up --build
#
# docker-compose.yml reads this file automatically.

# Required - create these at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, Web application type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required - secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional - restrict sign-in to your own address (recommended for self-hosted)
ALLOWED_EMAIL=

# Set to 'true' when running behind HTTPS (production). Marks auth and CSRF cookies
# as Secure so the browser never sends them over plain HTTP. Leave 'false' for local
# dev (localhost doesn't use HTTPS).
SECURE_COOKIES=false

# Optional - only needed when the frontend and backend are on different subdomains
# (e.g. app.example.com + api.example.com). Leave unset for localhost dev and
# single-origin deployments — the browser scopes cookies to the exact host automatically.
# COOKIE_DOMAIN=example.com

# Storage backend: 'sqlite' (default, no setup) or 'postgres'
STORAGE_BACKEND=sqlite

# LLM provider used for classification: 'rules' (default, no setup), 'ollama',
# 'openai', 'anthropic', or 'command'. See backend/README.md for details.
LLM_PROVIDER=rules
LLM_MODEL=

# Only used when LLM_PROVIDER=openai / anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=ollama - Ollama runs on the host machine, not in
# a container, so this points back out at it. Leave as-is unless Ollama is
# listening somewhere else.
OLLAMA_HOST=http://host.docker.internal:11434
